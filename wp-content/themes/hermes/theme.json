{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"customFontSize": false,
			"fontStyle": false,
			"fontFamilies": [
				{
                    "fontFamily": "\"PT Sans\", -apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif",
                    "name": "Headings Font",
					"slug": "headings-font"
				},
				{
                    "fontFamily": "\"PT Serif\", -apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif",
                    "name": "Body font",
					"slug": "body-font"
				}
			],
            "fontSizes": [
				{
                    "slug": "tiny",
                    "size": "var(--wp--custom--typography--xs)",
                    "name": "Tiny"
                },
                {
                    "slug": "small",
                    "size": "var(--wp--custom--typography--sm)",
                    "name": "Small"
                },
                {
                    "slug": "normal",
                    "size": "var(--wp--custom--typography--base)",
                    "name": "Normal"
                },
                {
                    "slug": "medium",
                    "size": "var(--wp--custom--typography--md)",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "var(--wp--custom--typography--lg)",
                    "name": "Large"
                },
                {
                    "slug": "huge",
                    "size": "var(--wp--custom--typography--xl)",
                    "name": "Huge"
                },
                {
                    "slug": "enormous",
                    "size": "var(--wp--custom--typography--2-xl)",
                    "name": "Enormous"
                },
                {
                    "slug": "gigantic",
                    "size": "var(--wp--custom--typography--3-xl)",
                    "name": "Gigantic"
                },
				{
                    "slug": "grand",
                    "size": "var(--wp--custom--typography--4-xl)",
                    "name": "Grand"
                }
            ]
        },
        "layout": {
            "contentSize": "760px",
            "wideSize": "1170px"
        },
        "color": {
			"link": true
		},
        "custom": {
			"spacing": {
				"small": "calc(var(--wp--style--block-gap) / 2)",
				"medium": "max(var(--wp--style--block-gap), 3.5vw)",
				"large": "max(calc( var(--wp--style--block-gap) * 1.5 ), 5vw)",
				"gapFlex": "1.75em"
			},
			"radius": {
				"base": "2px",
				"small": "1px",
				"full": "999px"
			},
			"border-width": {
				"blockquote": "2px",
				"button": "1px"
			},
			"typography": {
				"scale": "1.125",
				"base": "1rem",
				"xs": "calc(var(--wp--custom--typography--sm) / var(--wp--custom--typography--scale))",
				"sm": "calc(var(--wp--custom--typography--base) / var(--wp--custom--typography--scale))",
				"md": "calc(var(--wp--custom--typography--base) * var(--wp--custom--typography--scale))",
				"lg": "calc(var(--wp--custom--typography--md) * var(--wp--custom--typography--scale))",
				"xl": "calc(var(--wp--custom--typography--lg) * var(--wp--custom--typography--scale))",
				"2xl": "calc(var(--wp--custom--typography--xl) * var(--wp--custom--typography--scale))",
				"3xl": "calc(var(--wp--custom--typography--2-xl) * var(--wp--custom--typography--scale))",
				"4xl": "calc(var(--wp--custom--typography--3-xl) * var(--wp--custom--typography--scale))",
				"body": "var(--wp--custom--typography--base)"
			},
			"leading": {
				"snug": 1.45,
				"tight": 1.25,
				"tightest": 1.15,
				"baseline": 1.65,
				"relaxed": 1.7,
				"loose": 2,
				"none": 1
			},
			"tracking": {
				"tighter": "-0.05em",
				"tight": "-0.025em",
				"normal": "0",
				"wide": "0.025em",
				"wider": "0.05em",
				"widest": "0.5em"
			}
		}
    },
    "styles": {
        "spacing": {
			"blockGap": "2rem"
		},
        "color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--primary-base)"
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--normal)",
			"fontFamily": "var(--wp--preset--font-family--body-font)",
			"lineHeight": "var(--wp--custom--leading--baseline)"
		},
		"elements": {
            "h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--enormous)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-dark)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
        },
		"blocks": {
			"core/button": {
				"border": {
					"radius": "var(--wp--custom--radius--base)",
					"width": "1px"
				},
				"typography": {
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--headings-font)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textDecoration": "none",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "calc(var(--wp--custom--spacing--gap-flex) / 2.25)",
						"bottom": "calc(var(--wp--custom--spacing--gap-flex) / 2.25)",
						"left": "calc(var(--wp--custom--spacing--gap-flex) / 1.125)",
						"right": "calc(var(--wp--custom--spacing--gap-flex) / 1.125)"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--primary-dark)",
					"text": "var(--wp--preset--color--secondary-light)"
				}
			},
			"core/quote": {
				"border": {
					"width": "var(--wp--custom--border-width--blockquote)",
					"style": "solid",
					"color": "inherit"
				},
				"color": {
					"text": "var(--wp--preset--color--primary-dark)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"padding": {
						"left": "1.5em",
						"right": "1.5em"
					},
					"margin": {
						"top": "var(--wp--style--block-gap)",
						"bottom": "var(--wp--style--block-gap)"
					}
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "1.5em",
						"bottom": "1.5em"
					}
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"top": "0.75em",
						"bottom": "0.75em"
					}
				}
			},
			"core/separator": {
				"spacing": {
					"margin": {
						"top": "var(--wp--style--block-gap)",
						"bottom": "var(--wp--style--block-gap)"
					}
				}
			},
			"core/cover": {
				"spacing": {
					"padding": {
						"top": "var(--wp--style--block-gap)",
						"bottom": "var(--wp--style--block-gap)",
						"left": "var(--wp--style--block-gap)",
						"right": "var(--wp--style--block-gap)"
					}
				}
			},
			"core/list": {
				"spacing": {
					"margin": {
						"top": "var(--wp--style--block-gap)",
						"bottom": "var(--wp--style--block-gap)"
					}
				}
			},
			"core/gallery": {
				"spacing": {
					"margin": {
						"top": "var(--wp--style--block-gap)",
						"bottom": "var(--wp--style--block-gap)"
					}
				}
			},
			"core/search": {
				"spacing": {
					"margin": {
						"top": "var(--wp--style--block-gap)",
						"bottom": "var(--wp--style--block-gap)"
					}
				}
			}
		}
    }
}